container_commands:
  01_migrate:
    command: "source /var/app/venv/*/bin/activate && python3 manage.py migrate --noinput"
    leader_only: true
  02_seed_polls:
    command: "source /var/app/venv/*/bin/activate && python3 manage.py seed_polls"
    leader_only: true
  03_db_ownership:
    command: "chown webapp:webapp db.sqlite3"
    leader_only: true
